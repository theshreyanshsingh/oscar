# Copy this file to .env and fill it in. Restart the server after changes.

# --- Required: one key for everything -------------------------------------

# OpenRouter serves the speech model for calls and the chat model for WhatsApp:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional: web search, on calls and in WhatsApp -----------------------

# With a Firecrawl key, Oscar looks things up on the internet when someone
# asks for something current (weather, news, prices, opening hours):
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Optional: real phone calls through Twilio ----------------------------

# From https://console.twilio.com (Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Your Twilio phone number in international format, e.g. +14155550123
TWILIO_PHONE_NUMBER=

# A public https address that reaches this server, e.g. from `ngrok http 7860`
PUBLIC_URL=

# --- Server ---------------------------------------------------------------

# 127.0.0.1 keeps the dashboard on this computer. 0.0.0.0 opens it to every device
# that can reach this port, with no password: on a server, let the firewall (on
# EC2, the security group) decide who can reach it.
HOST=127.0.0.1
PORT=7860
