# Copy this file to .env and fill it in. Restart the server after changes.

# --- Required: one key for everything -------------------------------------

# OpenRouter serves the speech model for calls and the chat model for WhatsApp:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional: web search, on calls and in WhatsApp -----------------------

# With a Firecrawl key, Oscar looks things up on the internet when someone
# asks for something current (weather, news, prices, opening hours):
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Optional: real phone calls through Twilio ----------------------------

# From https://console.twilio.com (Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: the number Oscar calls from, in international format, e.g. +14155550123.
# You can leave it out and choose (or buy) numbers on the dashboard, under Phone.
TWILIO_PHONE_NUMBER=

# A public https address that reaches this server, e.g. from `ngrok http 7860`
PUBLIC_URL=

# --- Server ---------------------------------------------------------------

# 127.0.0.1 keeps the dashboard on this computer. 0.0.0.0 opens it to every device
# that can reach this port, so it then needs DASHBOARD_PASSWORD (below). Browser
# calls then also need UDP 32768-60999 let in through the firewall (on EC2, the
# security group): their audio goes straight to the server, not to this port.
HOST=127.0.0.1
PORT=7860

# The dashboard's password (README.md, Protect the dashboard). Set it with
#   .venv/bin/python -m scripts.set_keys --password
# which asks for it without showing it. Needed whenever other computers can reach
# Oscar (HOST=0.0.0.0, or PUBLIC_URL set): without it the dashboard stays locked
# for everyone. Changing it signs everyone out. Left empty on a Mac where only you
# can reach Oscar, the dashboard opens without one.
DASHBOARD_PASSWORD=

# The most calls Oscar is on at once (8 if left out). One more is turned away
# politely ("all our lines are busy") and shows in Call history, so the calls
# already going stay smooth (README.md, How many calls at once).
# MAX_CALLS=8

# Optional: Cloudflare Access as an extra layer in front of the password, on a
# server (README.md, Protect the dashboard): visitors then need both. Both or
# neither. The team domain is like yourteam.cloudflareaccess.com; the tag is the
# application's "Application Audience (AUD) Tag". Leave them empty otherwise.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
